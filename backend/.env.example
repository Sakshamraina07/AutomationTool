# AutoReach backend environment (copy to .env; .env is gitignored)

# --- Existing (LinkedIn Intern Helper) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3000

# --- AutoReach: open-pixel base URL ---
# Public base URL of THIS backend, used to build the open-tracking pixel src.
# e.g. https://your-backend.onrender.com  (no trailing slash)
APP_BASE_URL=

# --- AutoReach: Gmail API (send + read), server-side only ---
# Create an OAuth 2.0 client (Desktop app) in Google Cloud Console, grant
# scopes gmail.send + gmail.readonly, and mint a long-lived refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=

# --- AutoReach: local LLM for reply classification ---
OLLAMA_URL=http://localhost:11434

# --- AutoReach: sending safeguards ---
# Daily cap is user-configurable but hard-limited to 400 in code (§10).
OUTREACH_DAILY_CAP=80
# Hourly ceiling for the drip worker (safe band 30–50). Never exceeds the daily cap.
OUTREACH_HOURLY_CAP=40
# Max emails released per worker tick (once/min) — burst limiter.
OUTREACH_PER_MINUTE=2
